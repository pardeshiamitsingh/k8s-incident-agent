  "cards": [
    {
      "dot": "emerald",
      "title": "Primary path",
      "items": [
        "A query is screened, resolved to a Deployment or Pod, then queued",
        "The worker runs collect, classify, retrieve, diagnose, plan",
        "The UI polls GET /diagnose/{job_id} for the result in Redis"
      ]
    },
    {
      "dot": "rose",
      "title": "Untrusted input",
      "items": [
        "Normalise, mask PII and secrets, match injection patterns, then a local-LLM intent check",
        "Fails closed: 422 with a reason, or 503 if screening is down",
        "Logs and events are redacted before prompts, Redis and the UI"
      ]
    },
    {
      "dot": "cyan",
      "title": "Job execution",
      "items": [
        "Redis holds job state (24h TTL) and the diagnosis queue",
        "429 backpressure past MAX_IN_FLIGHT_JOBS",
        "SimpleWorker avoids the macOS fork crash; Chroma runs in server mode"
      ]
    },
    {
      "dot": "violet",
      "title": "Agent and knowledge",
      "items": [
        "A deterministic classifier feeds retrieval (dense default, hybrid opt-in)",
        "Diagnoses cite evidence and runbook chunks",
        "Confirmed postmortems are written back to Chroma"
      ]
    },
    {
      "dot": "amber",
      "title": "Trust boundaries",
      "items": [
        "Bearer token on every API call; the UI keeps it in sessionStorage",
        "Cluster access is read-only; the agent never mutates state",
        "Only LangSmith traces leave the machine, after masking"
      ]
    },
    {
      "dot": "slate",
      "title": "Also calls (not drawn)",
      "items": [
        "NL Intake calls Ollama and lists cluster objects to match names",
        "The API reads job state from Redis directly",
        "Guardrails call Ollama for the intent check"
      ]
    }
  ]
