  "cards": [
    {
      "dot": "cyan",
      "title": "Shared state, no direct calls",
      "items": [
        "Nodes never call each other; each returns a partial dict that LangGraph merges into AgentState",
        "The caller sets resolved_object and notes; every later field has one writer"
      ]
    },
    {
      "dot": "emerald",
      "title": "Who writes what",
      "items": [
        "collect: evidence",
        "classify: classified_failure_classes",
        "retrieve: retrieved_chunks",
        "diagnose: diagnosis",
        "plan: remediation_plan (final output)"
      ]
    },
    {
      "dot": "amber",
      "title": "LLM use and guardrails",
      "items": [
        "Only diagnose and plan call the LLM; classify is a deterministic reason table",
        "Citations must be non-empty, so an uncited diagnosis fails",
        "collect redacts PII, secrets and injection-like log lines; prompts treat evidence as untrusted data"
      ]
    },
    {
      "dot": "violet",
      "title": "Linear by design",
      "items": [
        "Five edges: entry at collect, plan ends the run; no branches or loops in v1",
        "A node error fails the run and the job",
        "Retrieval runs once per failure class (3 chunks each); Unknown falls back to a raw-text query"
      ]
    }
  ]
}
