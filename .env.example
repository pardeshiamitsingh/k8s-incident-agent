# Copy to .env (gitignored) and fill in to enable LangSmith tracing.
# Optional -- everything works locally without these; unset/false means
# no trace data leaves the machine (constitution principle 3 default).
#
# Named exception (constitution v1.2.0): when enabled, LangSmith tracing
# sends queries and retrieved runbook chunk metadata (and later, diagnosis
# prompts/completions) to LangChain's hosted LangSmith service.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=k8s-incident-agent

# Overrides where the local Chroma runbook collection is persisted.
# Defaults to .chroma/ at the repo root if unset.
INCIDENT_AGENT_CHROMA_PATH=
